{
  "name": "unified-ambulance-system",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev --workspace server\" \"npm start --workspace client\"",
    "server": "npm run dev --workspace server",
    "client": "npm start --workspace client",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:studio": "npm run prisma:studio --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  }
}
